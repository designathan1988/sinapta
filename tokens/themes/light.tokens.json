{
  "color": {
    "$type": "color",
    "bg": {
      "app": {
        "$value": "{base.color.day.bg}"
      },
      "sidebar": {
        "$value": "{base.color.day.sidebar}"
      },
      "raised": {
        "$value": "{base.color.day.raised}"
      },
      "hover": {
        "$value": "{base.color.day.hover}"
      },
      "active": {
        "$value": "{base.color.day.active}"
      },
      "selected": {
        "$value": "{base.color.day.selected}"
      },
      "code": {
        "$value": "{base.color.day.code}"
      },
      "scrim": {
        "$value": "{base.color.black.scrim}"
      }
    },
    "text": {
      "primary": {
        "$value": "{base.color.day.text}"
      },
      "secondary": {
        "$value": "{base.color.day.textSecondary}"
      },
      "tertiary": {
        "$value": "{base.color.day.textTertiary}"
      },
      "onAccent": {
        "$value": "{base.color.day.onAccent}"
      },
      "link": {
        "$value": "{base.color.day.link}"
      },
      "danger": {
        "$value": "{base.color.day.danger}"
      },
      "success": {
        "$value": "{base.color.day.success}"
      },
      "warning": {
        "$value": "{base.color.day.warning}"
      }
    },
    "border": {
      "subtle": {
        "$value": "{base.color.day.border}"
      },
      "default": {
        "$value": "{base.color.day.borderDefault}"
      },
      "strong": {
        "$value": "{base.color.day.borderStrong}"
      },
      "focus": {
        "$value": "{base.color.day.focus}"
      }
    },
    "accent": {
      "default": {
        "$value": "{base.color.day.accent}"
      },
      "hover": {
        "$value": "{base.color.day.accentHover}"
      },
      "subtle": {
        "$value": "{base.color.day.accentSubtle}"
      }
    },
    "status": {
      "dangerBg": {
        "$value": "{base.color.day.dangerBg}"
      }
    },
    "shadow": {
      "overlay": {
        "$value": "{base.color.day.shadow}"
      },
      "ring": {
        "$value": "{base.color.day.shadowRing}"
      }
    },
    "chip": {
      "gray": {
        "bg": {
          "$value": "{base.color.chip.gray.tint}"
        },
        "text": {
          "$value": "{base.color.chip.gray.ink}"
        }
      },
      "brown": {
        "bg": {
          "$value": "{base.color.chip.brown.tint}"
        },
        "text": {
          "$value": "{base.color.chip.brown.ink}"
        }
      },
      "orange": {
        "bg": {
          "$value": "{base.color.chip.orange.tint}"
        },
        "text": {
          "$value": "{base.color.chip.orange.ink}"
        }
      },
      "yellow": {
        "bg": {
          "$value": "{base.color.chip.yellow.tint}"
        },
        "text": {
          "$value": "{base.color.chip.yellow.ink}"
        }
      },
      "green": {
        "bg": {
          "$value": "{base.color.chip.green.tint}"
        },
        "text": {
          "$value": "{base.color.chip.green.ink}"
        }
      },
      "blue": {
        "bg": {
          "$value": "{base.color.chip.blue.tint}"
        },
        "text": {
          "$value": "{base.color.chip.blue.ink}"
        }
      },
      "purple": {
        "bg": {
          "$value": "{base.color.chip.purple.tint}"
        },
        "text": {
          "$value": "{base.color.chip.purple.ink}"
        }
      },
      "red": {
        "bg": {
          "$value": "{base.color.chip.red.tint}"
        },
        "text": {
          "$value": "{base.color.chip.red.ink}"
        }
      }
    },
    "code": {
      "keyword": {
        "$value": "{base.color.chip.purple.ink}"
      },
      "string": {
        "$value": "{base.color.chip.green.ink}"
      },
      "number": {
        "$value": "{base.color.chip.orange.ink}"
      },
      "comment": {
        "$value": "{base.color.neutral.600}"
      },
      "function": {
        "$value": "{base.color.chip.blue.ink}"
      },
      "punctuation": {
        "$value": "{base.color.neutral.650}"
      }
    }
  }
}
