{
  "name": "pagecraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "check:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "tokens": "node scripts/build-tokens.ts",
    "capture": "node scripts/capture.ts",
    "lint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/ && stylelint \"src/**/*.css\" --max-warnings 0 --cache --cache-location node_modules/.cache/stylelint/ && prettier --check .",
    "format": "prettier --write .",
    "verify": "npm run check && npm run lint && npm run test"
  },
  "dependencies": {
    "@tanstack/table-core": "9.3.1",
    "idb": "8.0.4",
    "lit-html": "3.3.3",
    "valibot": "1.5.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "happy-dom": "21.0.4",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
